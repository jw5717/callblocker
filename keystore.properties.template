# Copy this file to `keystore.properties` (same folder) and fill in your values.
# `keystore.properties` is git-ignored and must NEVER be committed.
#
# storeFile: path to your .jks keystore, relative to the project root.
#            e.g. release-key.jks  (if it sits next to this file)

storeFile=release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=callblocker
keyPassword=YOUR_KEY_PASSWORD
